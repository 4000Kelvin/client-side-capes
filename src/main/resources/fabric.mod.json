{
	"schemaVersion": 1,
	"id": "client-side-capes",
	"version": "0.1.0",
	"name": "Client Side Capes",
	"description": "Allows for the client-side application of custom capes to players",
	"authors": [
		"4000Kelvin"
	],
	"contact": {
		"homepage": "https://github.com/4000Kelvin/client-side-capes.git",
		"sources": "https://github.com/4000Kelvin/client-side-capes.git"
	},
	"license": "CC0-1.0",
	"icon": "assets/client-side-capes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.fourkkelvin.ClientSideCapes"
		],
		"modmenu": [
			"com.fourkkelvin.client.gui.ModMenuImplementation"
		],
		"client": [
			"com.fourkkelvin.client.ClientSideCapesClient"
		]
	},
	"mixins": [
		"client-side-capes.mixins.json",
		{
			"config": "client-side-capes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}